<resources>
    <style name="AppSystemBarThemeBase" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#101114</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="AppSystemBarTheme" parent="AppSystemBarThemeBase" />
    <style name="LaunchTheme" parent="AppSystemBarTheme" />
    <style name="NormalTheme" parent="AppSystemBarTheme" />
</resources>
